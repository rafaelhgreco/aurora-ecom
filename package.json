{
  "name": "aurora-ecom",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "seed:admin": "tsx scripts/seed-admin.ts",
    "validate:firebase-env": "tsx scripts/validate-firebase-env.ts",
    "backfill:product-slugs": "tsx scripts/backfill-product-slugs.ts",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.33.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.101.4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.7.0",
    "jose": "^6.2.2",
    "next": "16.1.6",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.12.0",
    "storybook-react": "https://raw.githubusercontent.com/rafaelhgreco/storybook-react/master/storybook-react-v1.0.0.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^30",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^16.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.2",
    "vitest": "^2.1.1"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
